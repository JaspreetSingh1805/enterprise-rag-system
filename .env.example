# ==============================================================================
# Enterprise Configurable RAG System - Environment Configuration
# ==============================================================================

# Application Environment & Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=supersecret-rag-platform-key-change-in-production

# Storage & SQLite Metadata DB
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/rag_metadata.db

# Vector Store Configuration
# Options: "qdrant" (production) or "memory" (testing)
VECTOR_STORE_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# Set QDRANT_PATH for embedded disk-based mode if running without docker service
# QDRANT_PATH=./data/qdrant_data

# LLM Providers Configuration
# Primary LLM Options: "openai", "ollama", "mock"
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama / Local LLM (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Embedding Providers Configuration
# Primary Embedding Options: "local", "openai", "mock"
DEFAULT_EMBEDDING_PROVIDER=local
# Local Embedding Model: "sentence-transformers/all-MiniLM-L6-v2" or "BAAI/bge-small-en-v1.5"
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pipeline Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_CHUNKING_STRATEGY=recursive
DEFAULT_SEARCH_MODE=hybrid
DEFAULT_SIMILARITY_THRESHOLD=0.35
DEFAULT_TOP_K=5
DEFAULT_RERANK_ENABLED=false
DEFAULT_QUERY_REWRITE_ENABLED=false
